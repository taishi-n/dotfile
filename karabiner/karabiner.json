{
    "global": {
        "show_in_menu_bar": false,
        "unsafe_ui": true
    },
    "profiles": [
        {
            "complex_modifications": {
                "parameters": {
                    "basic.simultaneous_threshold_milliseconds": 60,
                    "basic.to_if_alone_timeout_milliseconds": 500
                },
                "rules": [
                    {
                        "description": "WezTerm only: change control-h to delete_or_backspace",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.github\\.wez\\.wezterm$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "h",
                                    "modifiers": {
                                        "mandatory": ["control"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "delete_or_backspace",
                                        "modifiers": []
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Send escape when left_control is tapped twice quickly, otherwise keep normal control behavior",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "name": "left_control_tapped_once",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": {
                                    "key_code": "left_control",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_control" }],
                                "to_after_key_up": [
                                    {
                                        "set_variable": {
                                            "name": "left_control_tapped_once",
                                            "value": 0
                                        }
                                    }
                                ],
                                "to_if_alone": [
                                    { "key_code": "escape" },
                                    {
                                        "set_variable": {
                                            "name": "left_control_tapped_once",
                                            "value": 0
                                        }
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "left_control",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_control" }],
                                "to_delayed_action": {
                                    "to_if_canceled": [
                                        {
                                            "set_variable": {
                                                "name": "left_control_tapped_once",
                                                "value": 0
                                            }
                                        }
                                    ],
                                    "to_if_invoked": [
                                        {
                                            "set_variable": {
                                                "name": "left_control_tapped_once",
                                                "value": 0
                                            }
                                        }
                                    ]
                                },
                                "to_if_alone": [
                                    {
                                        "set_variable": {
                                            "name": "left_control_tapped_once",
                                            "value": 1
                                        }
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "escキーを押したときに、英数キーも送信する（vim用）",
                        "manipulators": [
                            {
                                "from": { "key_code": "escape" },
                                "to": [
                                    { "key_code": "escape" },
                                    { "key_code": "japanese_eisuu" }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
